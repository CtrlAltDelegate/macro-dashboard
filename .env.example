# Copy to .env and fill in. Never commit .env.
FRED_API_KEY=your_fred_key_here
# Optional: enables the AI Interpretation section (Anthropic Claude). ANTHROPIC_API_KEY also works.
CLAUDE_API_KEY=
# Optional: override the AI model (default claude-opus-5-5; e.g. claude-sonnet-5-5 or claude-haiku-5-5 to save cost)
# CLAUDE_MODEL=
